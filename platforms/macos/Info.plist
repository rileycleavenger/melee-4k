<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>melee</string>
    <key>CFBundleIconFile</key>
    <string>melee</string>
    <key>CFBundleIdentifier</key>
    <string>org.melee-pc.melee</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Melee</string>
    <key>CFBundleDisplayName</key>
    <string>Melee</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@MELEE_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@MELEE_VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.games</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- macOS 15+: online play finds and talks to players on the same network
         (mDNS discovery in src/pc/net_lan.c and the match socket). Without
         these the system can block that traffic without ever asking. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Melee 4K connects to other players on your network for online matches.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_meleepc._udp</string>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>GameCube disc image</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>iso</string>
                <string>gcm</string>
                <string>ciso</string>
                <string>rvz</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
